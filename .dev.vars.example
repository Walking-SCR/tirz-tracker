# Cloudflare Worker Secrets (Do NOT commit real values to Git)
# In production, set these using `npx wrangler secret put <KEY>` or in Cloudflare Dashboard:
# Workers & Pages -> Settings -> Variables and Secrets

# 1. GitHub Fine-Grained Personal Access Token (with Contents: Read & write permissions on tirz-tracker-data)
GITHUB_TOKEN="github_pat_xxxx"

# 2. Random 32+ character key used for HMAC-SHA256 cookie signing
AUTH_SIGNING_KEY="your-super-random-long-auth-signing-key-32chars"

# 3. One-time setup password for initial iPhone device authorization
BOOTSTRAP_SECRET="your-device-bootstrap-secret-code"
