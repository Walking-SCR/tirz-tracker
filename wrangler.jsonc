{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tirz-tracker",
  "account_id": "206f13a809f3ad5797d2962f904e3ccd",
  "main": "src/index.js",
  "compatibility_date": "2024-09-01",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "GITHUB_OWNER": "Walking-SCR",
    "GITHUB_DATA_REPO": "tirz-tracker-data",
    "GITHUB_BRANCH": "main",
    "ALLOWED_EMAIL": "walkingscr@gmail.com",
    "BOOTSTRAP_ENABLED": "true"
  }
}
