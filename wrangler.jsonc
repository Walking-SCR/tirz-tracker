{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tirz-tracker",
  "main": "src/index.js",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/setup"]
  },
  "vars": {
    "GITHUB_OWNER": "Walking-SCR",
    "GITHUB_DATA_REPO": "tirz-tracker-data",
    "GITHUB_BRANCH": "main",
    "ALLOWED_EMAIL": "",
    "BOOTSTRAP_ENABLED": "true"
  }
}
